#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════
# PixelScribe — one-command startup
# ═══════════════════════════════════════════════════════
# Serves the browser app from www/ and, with --backend, also brings up the
# optional Python OCR server.
#
#   ./Start                 web app only  (no Python needed)
#   ./Start --backend       web app + FastAPI OCR server on :8000
#
# On Windows use `npm start` instead — it runs the same static server.
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$SCRIPT_DIR/backend"

PYTHON="${PYTHON:-python3}"
API_PORT="${API_PORT:-8000}"
WEB_PORT="${WEB_PORT:-5173}"
WITH_BACKEND=0
[ "${1:-}" = "--backend" ] && WITH_BACKEND=1

echo ""
echo "  ██████╗ ██╗██╗  ██╗███████╗██╗      ███████╗ ██████╗██████╗ ██╗██████╗ ███████╗"
echo "  ██╔══██╗██║╚██╗██╔╝██╔════╝██║      ██╔════╝██╔════╝██╔══██╗██║██╔══██╗██╔════╝"
echo "  ██████╔╝██║ ╚███╔╝ █████╗  ██║      ███████╗██║     ██████╔╝██║██████╔╝█████╗  "
echo "  ██╔═══╝ ██║ ██╔██╗ ██╔══╝  ██║      ╚════██║██║     ██╔══██╗██║██╔══██╗██╔══╝  "
echo "  ██║     ██║██╔╝ ██╗███████╗███████╗ ███████║╚██████╗██║  ██║██║██████╔╝███████╗"
echo "  ╚═╝     ╚═╝╚═╝  ╚═╝╚══════╝╚══════╝ ╚══════╝ ╚═════╝╚═╝  ╚═╝╚═╝╚═════╝ ╚══════╝"
echo ""
echo "  Offline Content-Aware Image Text Editor"
echo "  ────────────────────────────────────────"
echo ""

# ── Node is required for the static server ────────────
if ! command -v node &>/dev/null; then
  echo "  ✗  Node.js not found. Install Node 18+ and retry."
  exit 1
fi
echo "  ✓  Node: $(node --version)"

# ── Verify the vendored WASM assets line up ───────────
node "$SCRIPT_DIR/scripts/check-assets.js" || {
  echo "  ✗  Vendor assets are incomplete — see the errors above."
  exit 1
}

API_PID=""
cleanup() { [ -n "$API_PID" ] && kill "$API_PID" 2>/dev/null || true; }
trap cleanup EXIT INT TERM

# ── Optional Python backend ───────────────────────────
if [ "$WITH_BACKEND" = "1" ]; then
  if ! command -v "$PYTHON" &>/dev/null; then
    echo "  ✗  Python not found. Install Python 3.10+ or drop --backend."
    exit 1
  fi
  echo "  ✓  Python: $($PYTHON --version)"

  VENV="$BACKEND_DIR/.venv"
  if [ ! -d "$VENV" ]; then
    echo "  →  Creating virtual environment…"
    "$PYTHON" -m venv "$VENV"
  fi
  # shellcheck disable=SC1091
  if [ -f "$VENV/bin/activate" ]; then source "$VENV/bin/activate"
  else source "$VENV/Scripts/activate"; fi   # Git Bash on Windows

  echo "  →  Installing dependencies (first run takes a few minutes)…"
  pip install -q --upgrade pip
  pip install -q -r "$BACKEND_DIR/requirements.txt"
  echo "  ✓  Dependencies ready."

  ( cd "$BACKEND_DIR" && uvicorn app:app --host 0.0.0.0 --port "$API_PORT" ) &
  API_PID=$!
  echo "  ✓  OCR server starting on :$API_PORT (point the app at it via More → OCR Server)"
fi

echo ""
echo "  ┌──────────────────────────────────────────────────┐"
echo "  │  App:   http://localhost:${WEB_PORT}                   │"
echo "  │  Demo:  http://localhost:${WEB_PORT}/?demo=1           │"
if [ "$WITH_BACKEND" = "1" ]; then
echo "  │  API:   http://localhost:${API_PORT}                    │"
echo "  │  Docs:  http://localhost:${API_PORT}/docs               │"
fi
echo "  │  Press Ctrl+C to stop                            │"
echo "  └──────────────────────────────────────────────────┘"
echo ""

node "$SCRIPT_DIR/server.js" --port "$WEB_PORT"
